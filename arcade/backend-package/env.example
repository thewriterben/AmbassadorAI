# DGD Arcade server environment. Names and placeholders only.
# Copy to arcade.env on the host, fill in, and keep it out of every repo.

NODE_ENV=production

# Required. 32+ random characters, different on staging and production.
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ARCADE_SECRET=<generate on the host>

# Required in production, never "*". No web page calls this API, so name only the host itself.
ARCADE_CORS=https://arcade-api.digitalgold.co

# 1 when exactly one reverse proxy you control appends X-Forwarded-For.
ARCADE_TRUST_PROXY=1

# Defaults shown. The database must live on the persistent volume.
# ARCADE_DB=data/arcade.sqlite
# ARCADE_BANK=data/bank
# PORT=8787

# Limits, defaults shown. Retunable without a deploy.
# RATE_PER_MINUTE=120
# PLAYERS_PER_HOUR=10
# MINI_REWARDED_ROUNDS_PER_DAY=10
# PASSAGE_JUVENILE_AT=1200
# PASSAGE_RAZORBACK_AT=4000
